{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.jj": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "kaishouri/tsconfig.json": true,
        "kaishouri/sentry.server.config.ts": true,
        "kaishouri/sentry.edge.config.ts": true,
        "kaishouri/postcss.config.mjs": true,
        "kaishouri/package-lock.json": true,
        "kaishouri/eslint.config.mjs": true,
        "kaishouri/.gitignore": true,
        "kaishouri/.env.sentry-build-plugin": true,
        "kaishouri/node_modules": true
    },
    "files.associations": {
    "*.css": "tailwindcss"
    },
    "hide-files.files": [
        "kaishouri/tsconfig.json",
        "kaishouri/sentry.server.config.ts",
        "kaishouri/sentry.edge.config.ts",
        "kaishouri/postcss.config.mjs",
        "kaishouri/package-lock.json",
        "kaishouri/eslint.config.mjs",
        "kaishouri/.gitignore",
        "kaishouri/.env.sentry-build-plugin",
        "kaishouri/node_modules"
    ]
}